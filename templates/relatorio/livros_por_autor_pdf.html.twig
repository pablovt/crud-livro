<!doctype html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8">
    <title>Livros por autor</title>
    <style>
        @page { margin: 1.5cm; }
        body { font-family: 'DejaVu Sans', sans-serif; font-size: 9pt; color: #222; }
        h1 { font-size: 15pt; color: #1f4e79; margin: 0; }
        h2 { font-size: 11pt; color: #1f4e79; margin: 14pt 0 4pt; }
        .gerado { color: #666; font-size: 8pt; margin: 2pt 0 8pt; }
        table { width: 100%; border-collapse: collapse; table-layout: fixed; }
        .col-titulo { width: 25%; }
        .col-assuntos { width: 26%; }
        .col-editora { width: 19%; }
        .col-edicao { width: 8%; }
        .col-ano { width: 7%; }
        .col-valor { width: 15%; }
        th { background: #1f4e79; color: #fff; text-align: left; padding: 3pt 4pt; }
        td { border-bottom: 0.5pt solid #ccc; padding: 3pt 4pt; }
        .numero { text-align: right; white-space: nowrap; }
        tfoot td { font-weight: bold; border-bottom: none; }
    </style>
</head>
<body>
<h1>Livros por autor</h1>
<p class="gerado">Gerado em {{ 'now'|date('d/m/Y H:i') }}</p>

{% for grupo in grupos %}
    <h2>{{ grupo.autor }}</h2>
    {% if grupo.livros is empty %}
        <p>Nenhum livro vinculado.</p>
    {% else %}
        <table>
            <thead>
            <tr>
                <th class="col-titulo">Título</th>
                <th class="col-assuntos">Assuntos</th>
                <th class="col-editora">Editora</th>
                <th class="numero col-edicao">Edição</th>
                <th class="numero col-ano">Ano</th>
                <th class="numero col-valor">Valor</th>
            </tr>
            </thead>
            <tbody>
            {% for livro in grupo.livros %}
                <tr>
                    <td>{{ livro.Titulo }}</td>
                    <td>{{ livro.Assuntos }}</td>
                    <td>{{ livro.Editora }}</td>
                    <td class="numero">{{ livro.Edicao }}ª</td>
                    <td class="numero">{{ livro.AnoPublicacao }}</td>
                    <td class="numero">{{ livro.Valor|format_currency('BRL') }}</td>
                </tr>
            {% endfor %}
            </tbody>
            <tfoot>
            <tr>
                <td colspan="5">{{ grupo.livros|length }} {{ grupo.livros|length == 1 ? 'livro' : 'livros' }}</td>
                <td class="numero">{{ grupo.total|format_currency('BRL') }}</td>
            </tr>
            </tfoot>
        </table>
    {% endif %}
{% else %}
    <p>Nenhum autor cadastrado.</p>
{% endfor %}
</body>
</html>

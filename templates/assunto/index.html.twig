{% extends 'base.html.twig' %}

{% block title %}Assuntos | {{ parent() }}{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">Assuntos</h1>
        <a class="btn btn-primary" href="{{ path('app_assunto_novo') }}">Novo assunto</a>
    </div>

    {% if assuntos is empty %}
        <p class="text-muted">Nenhum registro cadastrado.</p>
    {% else %}
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                <tr>
                    <th>Código</th>
                    <th>Descrição</th>
                    <th class="text-end">Ações</th>
                </tr>
                </thead>
                <tbody>
                {% for assunto in assuntos %}
                    <tr>
                        <td>{{ assunto.id }}</td>
                        <td>{{ assunto.descricao }}</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-outline-primary btn-sm" href="{{ path('app_assunto_editar', {id: assunto.id}) }}">Editar</a>
                            {% include '_partials/excluir.html.twig' with {
                                action: path('app_assunto_excluir', {id: assunto.id}),
                                token_id: 'excluir_assunto' ~ assunto.id,
                                nome: assunto.descricao,
                            } only %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock %}
